# pHelix Vault — placeholder values only. Never commit real secrets.

ENVIRONMENT=development
DEBUG=true
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+psycopg://phelix:phelix@localhost:5432/phelix_vault

JWT_SECRET=CHANGE_ME_DEV_ONLY_NOT_FOR_PRODUCTION
JWT_ALGORITHM=HS256
JWT_AUDIENCE=phelix-vault
JWT_ISSUER=phelix-dev

STORAGE_BACKEND=local
LOCAL_STORAGE_ROOT=/tmp/phelix-vault-objects
STORAGE_RESIDENCY=TR

# S3-compatible (MinIO / AWS)
# STORAGE_BACKEND=s3
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=phelix-vault
S3_REGION=us-east-1

KMS_PROVIDER=development
DEVELOPMENT_KEK=dev-only-kek-not-for-production

UPLOAD_SESSION_TTL_SECONDS=3600
SIGNED_URL_TTL_SECONDS=300
ENABLE_RLS=false
